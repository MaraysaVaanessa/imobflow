// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  properties    Property[]
  owners        Owner[]
  tenants       Tenant[]
  contracts     Contract[]
  payments      Payment[]
  maintenances  Maintenance[]
  appointments  Appointment[]
  inspections   Inspection[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("operador")
  photoUrl     String?
  createdAt    DateTime @default(now())

  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id])
}

model Property {
  id Int @id @default(autoincrement())
  address String
  type String
  rentValue Decimal
  bedrooms Int
  bathrooms Int
  status String @default("disponivel")
  createdAt DateTime @default(now())
  photoUrl String?
  contracts Contract[]
  maintenances Maintenance[]
  appointments Appointment[]
  inspections Inspection[]
  photos PropertyPhoto[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model PropertyPhoto {
  id          Int      @id @default(autoincrement())
  url         String
  createdAt   DateTime @default(now())

  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id])
}

model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  cpf       String
  address   String
  createdAt DateTime @default(now())
  photoUrl  String?
  contracts Contract[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([cpf, companyId])
}

model Tenant {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String
  email             String
  cpf               String
  guarantorName     String
  guarantorPhone    String
  guarantorAddress  String
  createdAt         DateTime @default(now())
  contracts Contract[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([cpf, companyId])
}

model Contract {
  id                  Int       @id @default(autoincrement())
  startDate           DateTime
  endDate             DateTime
  rentValue           Decimal
  dueDay              Int
  status              String    @default("ativo")
  lastAdjustmentDate  DateTime?
  createdAt           DateTime  @default(now())

  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id])

  ownerId     Int
  owner       Owner    @relation(fields: [ownerId], references: [id])

  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  payments Payment[]
  inspections Inspection[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model Payment {
  id          Int       @id @default(autoincrement())
  dueDate     DateTime
  value       Decimal
  status      String    @default("pendente")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  contractId  Int
  contract    Contract  @relation(fields: [contractId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model Maintenance {
  id             Int       @id @default(autoincrement())
  description    String
  status         String    @default("pendente")
  openedAt       DateTime  @default(now())
  estimatedCost  Decimal
  resolvedAt     DateTime?
  photoUrl       String?

  propertyId     Int
  property       Property  @relation(fields: [propertyId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model Appointment {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  date         DateTime
  status       String    @default("pendente")
  createdAt    DateTime  @default(now())

  propertyId   Int?
  property     Property? @relation(fields: [propertyId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  status    String   @default("aberto")
  createdAt DateTime @default(now())
}

model Inspection {
  id          Int      @id @default(autoincrement())
  type        String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id])

  contractId  Int?
  contract    Contract? @relation(fields: [contractId], references: [id])

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])

  items       InspectionItem[]
}

model InspectionItem {
  id            Int        @id @default(autoincrement())
  roomName      String
  observation   String?
  photoUrl      String?

  inspectionId  Int
  inspection    Inspection @relation(fields: [inspectionId], references: [id])
}